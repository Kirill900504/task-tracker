# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# public CA cert (not a secret) needed at runtime for GigaChat's TLS chain
!certs/russian-trusted-root-ca.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# personal data — never commit real business data
/import-data

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# e2e
/test-results
/playwright-report
/e2e/.e2e-user.json
/e2e/.e2e-user-*.json

# Throwaway helper scripts used while testing (disposable Supabase accounts,
# fixtures) — never part of the app.
scripts/_*

# desktop app: the wrapper's own dependencies, its built installers and the
# screenshots its smoke run leaves behind. The installer is published as a
# GitHub release, never committed — it is 91 MB of Electron.
/desktop/node_modules
/desktop/dist
/desktop/smoke-*.png

# Разовые проверочные скрипты: пишутся под конкретный вопрос и живут
# ровно до ответа на него.
scripts/.tmp/

# Снимки экрана, которыми проверяют вид: Playwright кладёт их в корень, и
# живут они ровно до того, как на них посмотрели. Правило здесь потому,
# что забытый файл в корне ничем не отличается от нужного, а `git add -A`
# в общей рабочей копии заберёт его молча — 20.09.2026 такой снимок
# пролежал в дереве полдня, пока его не заметила соседняя сессия.
/*-shot.png
/*-screenshot.png

# Записки о незаконченной работе и их архив. Лежат ВНУТРИ рабочей копии
# нарочно, хотя в историю проекта им незачем: всё, что дежурный делает за
# её пределами, требует разрешения, а разрешение в автономной сессии дать
# некому — 21.09.2026 прогон встал на чтении этого каталога по старому
# адресу (~/.claude/unfinished) и провисел сутки, заблокировав собой все
# следующие. Каталог внутри cwd снимает вопрос целиком.
/.unfinished
